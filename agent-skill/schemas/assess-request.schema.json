{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dog-health-check.local/schemas/assess-request.schema.json",
  "title": "DogHealthAssessRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "age",
    "breed",
    "size",
    "bodyCondition",
    "foodTypes",
    "snackLevel",
    "movement",
    "recentSignals",
    "homeEnvironment",
    "mentalState"
  ],
  "properties": {
    "dogName": {
      "type": "string",
      "description": "可选，狗狗昵称。不要包含用户个人信息。",
      "maxLength": 60
    },
    "age": {
      "type": "string",
      "description": "狗狗年龄，例如 '3 岁' 或 '8 months'。",
      "minLength": 1,
      "maxLength": 60
    },
    "breed": {
      "type": "string",
      "description": "品种或混种描述。",
      "minLength": 1,
      "maxLength": 80
    },
    "weight": {
      "type": "string",
      "description": "体重，可选，例如 '10kg'。",
      "maxLength": 80
    },
    "size": {
      "type": "string",
      "enum": ["small", "medium", "large", "unknown"]
    },
    "bodyCondition": {
      "type": "string",
      "enum": ["thin", "ideal", "slightly_fat", "obese", "unknown"]
    },
    "foodTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["kibble", "canned", "freeze_dried", "fresh", "homemade", "mixed"]
      }
    },
    "snackLevel": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outdoorFrequency", "dailyMinutes", "sniffing"],
      "properties": {
        "outdoorFrequency": {
          "type": "string",
          "enum": ["rare", "once_toilet_only", "one_to_two", "two_to_three", "two_plus"]
        },
        "dailyMinutes": {
          "type": "string",
          "enum": ["unknown", "under_10", "10_20", "around_30", "over_30"]
        },
        "sniffing": {
          "type": "string",
          "enum": ["none", "little", "normal", "rich", "unknown"]
        }
      }
    },
    "recentSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "normal 只能单独使用。persistent_cough、饮水排尿、体重和持续食欲变化用于普通健康关注；明确危险信号由安全边界分流。",
      "items": {
        "type": "string",
        "enum": [
          "normal",
          "unstable_poop",
          "bad_breath",
          "paw_licking_or_scratching",
          "persistent_cough",
          "drinking_or_urination_change",
          "unexplained_weight_change",
          "low_energy",
          "appetite_change",
          "vomiting",
          "diarrhea",
          "pain",
          "mobility_issue",
          "breathing_difficulty",
          "collapse_seizure_or_fainting",
          "swollen_abdomen_or_unproductive_retching"
        ]
      }
    },
    "homeEnvironment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "none 或 unknown 只能单独使用。",
      "items": {
        "type": "string",
        "enum": [
          "aromatherapy",
          "strong_cleaner",
          "secondhand_smoke",
          "plastic_bowl",
          "pesticide",
          "none",
          "unknown"
        ]
      }
    },
    "mentalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveEngagement", "relaxation", "socialConnection", "distressSignals"],
      "properties": {
        "positiveEngagement": { "type": "string", "enum": ["often", "sometimes", "rare", "unknown"] },
        "relaxation": { "type": "string", "enum": ["easy", "sometimes_difficult", "often_difficult", "unknown"] },
        "socialConnection": { "type": "string", "enum": ["secure", "variable", "withdrawn", "unknown"] },
        "distressSignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "none 或 unknown 只能单独使用。",
          "items": {
            "type": "string",
            "enum": ["frequent_fear_or_hiding", "separation_distress", "persistent_pacing_or_vocalizing", "repetitive_behavior", "sudden_behavior_change", "aggression_safety_risk", "self_injury", "none", "unknown"]
          }
        }
      }
    }
  }
}
