# Local development only. Mock modes never send SMS or charge real money.
AUTH_MODE=mock
PAYMENT_MODE=mock
DOGCARE_STORE_FILE=.data/dogcare-dev.json
# File storage is local-only. Do not enable this in production; use a database adapter.
DOGCARE_ALLOW_FILE_STORE=false

# Production must use a durable database and real SMS provider before enabling accounts.
# AUTH_MODE=sms
# SMS_PROVIDER=
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=

# WeChat Pay merchant configuration. Keep secrets server-side only.
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_CERT_SERIAL_NO=
# WECHAT_PAY_PUBLIC_KEY_ID=
# WECHAT_PAY_PUBLIC_KEY=
# WECHAT_PAY_NOTIFY_URL=https://dogcare.cc/api/payments/wechat/notify

# Alipay merchant application configuration. Keep private keys server-side only.
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# Production callback base, for example https://dogcare.cc
# PAYMENT_PUBLIC_BASE_URL=
